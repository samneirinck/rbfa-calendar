{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rbfa-calendar",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"observability": {
		"enabled": true
	},
	"cache": {
		"enabled": true
	},
	"exports": {
		"default": { "type": "worker" },
		"MatchDetails": { "type": "worker" }
	},
	"upload_source_maps": true
}
